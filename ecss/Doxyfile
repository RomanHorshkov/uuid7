# Doxyfile — the one site of the ECSS qualification package: the API reference of app/ and the tests, the ECSS documents generated
# into build/ecss/md, the requirement cross-references, the diagrams. Run from the repository root by ecss/make.sh (ECSS_VERSION).
PROJECT_NAME           = "uuid7"
PROJECT_NUMBER         = "$(ECSS_VERSION)"
PROJECT_BRIEF          = "Time-ordered UUIDv7 — ECSS qualification package (category D)"
OUTPUT_DIRECTORY       = build/ecss
CREATE_SUBDIRS         = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "$(ECSS_ROOT)" "$(ECSS_ROOT)/build/ecss/md"
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
ALIASES                = "satisfies=\xrefitem satisfies \"Satisfies\" \"Implementation trace (code to requirement)\"" \
                         "verifies=\xrefitem verifies \"Verifies\" \"Verification trace (test to requirement)\""
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = build/ecss/doxygen_warnings.txt
INPUT                  = build/ecss/md app tests/ITs tests/plantuml tests/stress tests/package
FILE_PATTERNS          = *.md *.dox *.h *.c
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */rms_export/*
USE_MDFILE_AS_MAINPAGE = build/ecss/md/index.md
IMAGE_PATH             = build/ecss/svg
FILTER_PATTERNS        = "*.c=python3 ecss/tools/doxy_filter.py" "*.h=python3 ecss/tools/doxy_filter.py"
FILTER_SOURCE_FILES    = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
VERBATIM_HEADERS       = YES
ALPHABETICAL_INDEX     = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = UUID7_TESTING __linux__ "_Atomic(x)=x"
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 60
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
GROUP_GRAPHS           = YES
DIRECTORY_GRAPH        = YES
DOT_CLEANUP            = YES
