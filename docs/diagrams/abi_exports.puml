@startuml
' claim: the public header decides both abi/layout.txt and the exports of libuuid7.so; the gate refuses any drift between them
rectangle "app/uuid7.h" as H
rectangle "abi/layout.txt\n(committed, SemVer-gated)" as L
rectangle "utils/uuid7.map\nUUID7_<major> { exactly the declared functions }" as M
rectangle "build/release/libuuid7.so" as S
H --> L : utils/check_abi.sh (stage abi)
L --> M : the function lines
M --> S : --version-script
S ..> L : utils/check_abi.sh --exports (stage abi-exports)
@enduml
